# .env приложения на хостинге reg.ru. CI собирает его один раз (если на сервере .env ещё нет):
# __APP_KEY__ — новый ключ, __SITE_PATH__ — абсолютный путь папки сайта, __DEPLOY_TOKEN__ — секрет DEPLOY_TOKEN.
# Существующий .env на сервере CI не трогает: правки — вручную через файловый менеджер панели.
APP_NAME="Андрей Матузов"
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=https://matuzov.ru
ASSET_URL=https://matuzov.ru

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Фоновых процессов на хостинге нет — очередь выполняется сразу.
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

CONTENT_SOURCE=database
PUBLIC_SITE_PATH=__SITE_PATH__
DEPLOY_TOKEN=__DEPLOY_TOKEN__
KP_ENDPOINT=/api/kp-lead
