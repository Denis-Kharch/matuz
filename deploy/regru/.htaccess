# Статичный сайт (выгрузка site:export) на хостинге reg.ru (Apache за nginx).
# HTTPS терминирует nginx хостинга, Apache видит обычный HTTP — поэтому переадресацию на https
# здесь НЕ делаем (будет бесконечный цикл). Её включают в панели хостинга: «Перенаправлять на HTTPS».
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes
AddType image/x-icon .ico
AddType application/manifest+json .webmanifest
# Без автоматического «/events → /events/»: Apache строил бы адрес с http://.
DirectorySlash Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    # www.matuzov.ru → matuzov.ru
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
    # Сам входной файл не переписываем.
    RewriteRule ^app\.php$ - [L]
    # Служебные пути (админка, livewire и livewire-<хеш> из Livewire 4, приём заявок КП, деплой) — в Laravel;
    # существующий статичный файл выигрывает.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(admin|livewire(-[0-9a-f]+)?|api/kp-lead|_deploy)(/.*)?$ app.php [L,QSA]
    # /events и /cases/<slug> (без слэша) отдаём из папки/index.html — без переадресации.
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # Сборка Vite с хешами в именах — можно кешировать надолго
    <If "%{REQUEST_URI} =~ m#^/build/#">
        ExpiresDefault "access plus 1 year"
    </If>
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
