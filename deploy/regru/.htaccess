# Статичный сайт (выгрузка site:export) на хостинге reg.ru (Apache).
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Только HTTPS и без www
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://matuzov.ru%{REQUEST_URI} [L,R=301]
    # /events → /events/ (страницы лежат как папка/index.html)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # Сборка Vite с хешами в именах — можно кешировать надолго
    <If "%{REQUEST_URI} =~ m#^/build/#">
        ExpiresDefault "access plus 1 year"
    </If>
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
